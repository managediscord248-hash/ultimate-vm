[Unit]
Description=AZMAL Persistent Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/app
Environment=PYTHONUNBUFFERED=1
Environment=PORT=10000
ExecStart=/opt/venv/bin/uvicorn server:app --host 0.0.0.0 --port 10000
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
